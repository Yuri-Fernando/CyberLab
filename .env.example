# =============================================================================
# CyberLab - Variáveis de Ambiente
# =============================================================================
# IMPORTANTE: Copie este arquivo para .env e configure com seus valores
# NUNCA commit .env com senhas reais!

# =============================================================================
# AMBIENTE DO LAB
# =============================================================================

# IP da máquina alvo (Metasploitable 2 ou DVWA)
TARGET_IP=192.168.56.101

# Porta SSH (para verificações)
SSH_PORT=22

# Porta FTP
FTP_PORT=21

# Porta SMB
SMB_PORT=445

# Porta DVWA (Apache)
DVWA_PORT=80

# =============================================================================
# CREDENCIAIS DE TESTE (para Metasploitable 2)
# =============================================================================

# Usuário padrão Metasploitable
TEST_USER=msfadmin

# Senha padrão Metasploitable
TEST_PASSWORD=msfadmin

# Usuário para SMB
SMB_USER=root

# Senha para SMB
SMB_PASSWORD=root

# =============================================================================
# WORDLISTS
# =============================================================================

# Caminho para arquivo de usuários
WORDLIST_USERS=./wordlists/ftp_users.txt

# Caminho para arquivo de senhas
WORDLIST_PASSWORDS=./wordlists/ftp_passwords.txt

# =============================================================================
# NMAP
# =============================================================================

# Agressividade do scan (0-5, recomendado: 3-4 para lab)
NMAP_TIMING=4

# Porta de início do scan
NMAP_PORT_START=1

# Porta de término do scan
NMAP_PORT_END=65535

# =============================================================================
# MEDUSA
# =============================================================================

# Número de threads paralelos
MEDUSA_THREADS=4

# Timeout por tentativa (segundos)
MEDUSA_TIMEOUT=10

# =============================================================================
# LOGS
# =============================================================================

# Diretório para salvar logs
LOG_DIR=./results/logs

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# MALWARE SIMULADO
# =============================================================================

# Diretório para teste de ransomware
RANSOMWARE_TEST_DIR=./results/test_files

# Arquivo de saída do keylogger
KEYLOGGER_OUTPUT=./results/keylogger.log

# =============================================================================
# RELATÓRIOS
# =============================================================================

# Diretório para salvar relatórios
REPORT_DIR=./results

# Gerar HTML report
GENERATE_HTML_REPORT=true

# =============================================================================
# DEBUG
# =============================================================================

# Ativar modo debug
DEBUG=false

# Ativar verbose output
VERBOSE=true
